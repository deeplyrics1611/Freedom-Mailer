# ---- Server ----
PORT=3000
# Public base URL used to build confirm/unsubscribe links in emails.
APP_BASE_URL=http://localhost:3000

# ---- Security ----
# Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
# First-run bootstrap admin. Created only if no users exist yet.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme123

# ---- Sending policy ----
# Global cap on messages processed per minute by the worker.
GLOBAL_RATE_PER_MINUTE=60
# Require every email recipient to have confirmed (double opt-in) before
# campaign sends are allowed. Transactional API sends bypass list opt-in
# but still respect the suppression list.
REQUIRE_DOUBLE_OPT_IN=true

# Optional physical address default (users can also set this in Account).
PHYSICAL_ADDRESS=

# ---- Default/system SMTP (optional) ----
# Users can also add their own SMTP identities in the panel. These are the
# fallback "system" credentials. Use an account/domain you actually own.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Freedom Mailer
SMTP_FROM_EMAIL=

# ---- SMS provider (optional, Twilio-compatible) ----
# Legitimate gateway only. Leave blank to disable SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
