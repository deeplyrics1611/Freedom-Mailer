# ---- Server ----
PORT=3000
# Public base URL used to build confirm/unsubscribe links in emails.
APP_BASE_URL=http://localhost:3000

# ---- Security ----
# Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
# Key used to encrypt stored mailbox app passwords (AES-256-GCM). Set this to
# its own long random value. Changing it makes existing stored app passwords
# unreadable — you would need to re-enter them. Defaults to JWT_SECRET.
CREDENTIAL_KEY=
# First-run bootstrap admin. Created only if no users exist yet.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme123

# ---- Sending policy ----
# Global cap on messages processed per minute by the worker.
GLOBAL_RATE_PER_MINUTE=60
# Require every email recipient to have confirmed (double opt-in) before
# campaign sends are allowed. Transactional API sends bypass list opt-in
# but still respect the suppression list.
REQUIRE_DOUBLE_OPT_IN=true

# ---- Default/system SMTP (optional) ----
# Users can also add their own SMTP identities in the panel. These are the
# fallback "system" credentials. Use an account/domain you actually own.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Freedom Mailer
SMTP_FROM_EMAIL=

# ---- SMS provider (optional, Twilio-compatible) ----
# Legitimate gateway only. Leave blank to disable SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Lead validation ----
# Mailbox-existence checks talk to the recipient's mail server on port 25.
# Most cloud hosts block outbound port 25; when that happens the app reports
# results as "unknown" rather than guessing. Check Validation > capabilities
# to see whether this host can do it.
VERIFY_SMTP_PROBE=true
# HELO name and envelope sender used for those probes. Point them at a domain
# you control with matching forward/reverse DNS — many servers refuse to answer
# probes from a host that cannot identify itself.
VERIFY_HELO_NAME=localhost
VERIFY_MAIL_FROM=
VERIFY_TIMEOUT_MS=8000
# Addresses checked in parallel during a bulk job. Raising this speeds up large
# batches but makes you look like a dictionary attack to some receivers.
VERIFY_CONCURRENCY=5

# ---- Link checking (optional) ----
# Google Safe Browsing API key. Without it the link checker still traces
# redirects and queries URI blocklists, but skips the Safe Browsing lookup.
SAFE_BROWSING_API_KEY=
